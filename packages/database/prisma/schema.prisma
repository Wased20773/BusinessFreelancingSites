// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OnboardingIntent {
  staff
  business
  developer
}

enum AccessLevel {
  developer
  owner
  admin
  staff
}

enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

model BusinessApiKey {
  id         String @id @default(uuid())
  businessId String

  name      String
  keyHash   String @unique
  keyPrefix String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Business {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  domain    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     BusinessUser[]
  locations Location[]
  apiKeys   BusinessApiKey[]
}

model User {
  id                  String            @id @default(uuid())
  name                String?
  username            String?
  email               String            @unique
  emailVerified       DateTime?
  image               String?
  onboardingCompleted Boolean           @default(false)
  onboardingIntent    OnboardingIntent?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  businesses BusinessUser[]
  accounts   Account[]
  sessions   Session[]
}

model BusinessUser {
  id         String   @id @default(uuid())
  businessId String
  userId     String
  roleId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

model Role {
  id          String      @id @default(uuid())
  accessLevel AccessLevel
  description String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users BusinessUser[]
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Location {
  id          String   @id @default(uuid())
  businessId  String
  address     String
  zip         String?
  country     String?
  state       String?
  city        String?
  parking     Boolean  @default(false)
  isActive    Boolean  @default(true)
  enableHours Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  days       LocationDay[]
  categories Category[]
  contacts   Contact[]
  socials    Social[]
  items      Item[]

  @@unique([businessId, address])
  @@index([businessId])
}

model LocationDay {
  id         String    @id @default(uuid())
  locationId String
  dayOfWeek  DayOfWeek
  isClosed   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hour         Hour?  @relation("RegularHour")
  specialHours Hour[] @relation("SpecialHours")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@index([locationId])
}

model Hour {
  id         String   @id @default(uuid())
  openTime   String
  closeTime  String
  title      String?
  note       String?
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Regular weekly hour
  regularDayId String?      @unique
  regularDay   LocationDay? @relation("RegularHour", fields: [regularDayId], references: [id], onDelete: Cascade)

  // Special hour
  specialDayId String?
  specialDay   LocationDay? @relation("SpecialHours", fields: [specialDayId], references: [id], onDelete: Cascade)

  @@unique([specialDayId, openTime, closeTime])
  @@index([specialDayId])
}

model Category {
  id                     String   @id @default(uuid())
  locationId             String
  parentId               String?
  name                   String
  description            String?
  order                  Int      @default(1)
  isVisible              Boolean  @default(true)
  syncGroupId            String?
  allowLocationOverrides Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  parent   Category? @relation("CategorySubcategories", fields: [parentId], references: [id], onDelete: Restrict)

  subcategories Category[] @relation("CategorySubcategories")
  items         Item[]

  @@unique([locationId, parentId, name])
  @@index([locationId, parentId])
  @@index([syncGroupId])
}

model Contact {
  id                     String   @id @default(uuid())
  locationId             String
  phoneNumber            String?
  email                  String?
  isPersonal             Boolean  @default(false)
  syncGroupId            String?
  allowLocationOverrides Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([syncGroupId])
}

model Social {
  id                     String   @id @default(uuid())
  locationId             String
  domain                 String
  profileName            String
  url                    String
  icon                   String
  syncGroupId            String?
  allowLocationOverrides Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, domain, profileName])
  @@index([locationId])
  @@index([syncGroupId])
}

model Item {
  id                     String   @id @default(uuid())
  locationId             String
  categoryId             String
  name                   String
  description            String?
  containsList           String[]
  calories               Int?
  price                  Decimal  @db.Decimal(10, 2)
  order                  Int      @default(1)
  isAvailable            Boolean  @default(true)
  slug                   String
  imageKey               String?
  syncGroupId            String?
  allowLocationOverrides Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  options ItemOption[]

  @@unique([locationId, slug])
  @@index([locationId])
  @@index([categoryId])
  @@index([syncGroupId])
}

model ItemOption {
  id                     String   @id @default(uuid())
  itemId                 String
  name                   String
  price                  Decimal  @db.Decimal(10, 2)
  order                  Int      @default(1)
  isAvailable            Boolean  @default(true)
  syncGroupId            String?
  allowLocationOverrides Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, name])
  @@index([itemId])
  @@index([syncGroupId])
}
